{
  "enabled": false,
  "root": "../../environment/data/business",
  "maxWorkers": 2,
  "routerModel": { "provider": "deepseek-account", "model": "deepseek-flash", "reasoningEffort": "off" },
  "agents": [
    { "id": "dsh", "backend": "dsh", "label": "代码助理", "description": "原生代码工具、Skill和MCP，可运行代码检查与登记的验证流程。", "capabilities": ["files", "code", "native-skills", "native-mcp"], "available": true, "command": "C:/replace-with-installed-dsh/dsh.cmd", "provider": "deepseek-account", "model": "deepseek-flash" },
    { "id": "pi", "backend": "pi", "label": "数据助理", "description": "结构化数据核对、文件处理，支持显式Skill和直接声明的MCP工具。", "capabilities": ["files", "data-check", "native-skills", "native-mcp"], "available": true, "command": "C:/replace-with-installed-pi/pi.exe", "dataHome": "C:/replace-with-pi-data" },
    { "id": "hermes", "backend": "hermes", "label": "文档助理", "description": "原生文档待办Skill和ACP工具会话，保留原文引用及未明确字段。", "capabilities": ["files", "document-skill", "native-mcp"], "available": true, "command": "C:/replace-with-installed-hermes/hermes.exe", "dataHome": "C:/replace-with-hermes-data" }
  ],
  "workers": [
    { "id": "code-check", "label": "代码检查", "description": "分析给定代码和回归点，输出可核对建议，在任务独立目录处理。", "allowedAgents": ["dsh"], "requiredCapabilities": ["code"] },
    { "id": "data-check", "label": "数据核对", "description": "核对给定数字、表格与业务统计，结果应可逐项复核。", "allowedAgents": ["pi"], "requiredCapabilities": ["data-check"] },
    { "id": "document-actions", "label": "整理待办", "description": "加载已登记文档Skill，从会议纪要提取责任人、期限和引用，未明确字段保持待确认。", "allowedAgents": ["hermes"], "requiredCapabilities": ["document-skill"], "skills": ["document-to-action-items"] },
    { "id": "assistant", "label": "协作助理", "description": "其他明确交办的资料整理和解释任务。", "allowedAgents": ["dsh", "pi", "hermes"], "requiredCapabilities": ["files"] }
  ],
  "workerResources": {
    "document-actions": { "agents": { "hermes": { "skillPaths": ["C:/replace-with-hermes-data/skills/productivity/document-to-action-items/SKILL.md"] } } }
  }
}
