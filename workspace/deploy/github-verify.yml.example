name: Verify iteration
on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
permissions:
  contents: read
jobs:
  server-and-bridge:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - run: pip install -r workspace/requirements-dev.txt
      - run: python -m pytest tests -q
        working-directory: workspace
      - run: npm run check
        working-directory: workspace
      - run: node --test
        working-directory: workspace/bridge
  windows-client:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - run: npm ci
        working-directory: workspace
      - run: npm run check
        working-directory: workspace
      - run: npm run build
        working-directory: workspace
      - uses: actions/upload-artifact@v4
        with:
          name: TeamRelay-Windows
          path: outputs/TeamRelay-win32-x64/
